# PostgreSQL ulanish satri (Neon, Supabase yoki boshqa). Lokal ham, hosting ham shu turdagi bazani ishlatadi.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Saytning ochiq manzili (hostingda: https://loyiha.vercel.app yoki domen). OG va havolalar shu manzildan.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Auth.js maxfiy kaliti: `npx auth secret` yoki istalgan 32+ baytli tasodifiy satr
AUTH_SECRET=""
# Ro'yxatdan o'tish yo'q: mijozlarga yashirin hisob ochiladi, boshqa qurilmadan /kalit/{kalit} havolasi orqali qaytadi.
# Admin panelga kirish kaliti: /admin/kirish sahifasida kiritiladi (kamida 16 belgi, tasodifiy satr).
ADMIN_KEY=""
# To'lov (Faza 4 — tayyorgarlik). Kalitlarni faqat shu yerga yozing, kodga emas.
# «Namuna» belgisini olib tashlash narxi, so'mda. Bo'sh bo'lsa narx ko'rsatilmaydi.
PRICE_UZS=""
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
PAYME_MERCHANT_ID=""
PAYME_KEY=""
# Mijozlar to'lov bo'yicha murojaat qiladigan Telegram (masalan: taklifnoma_admin), to'lov ulanguncha ko'rsatiladi
SUPPORT_TELEGRAM=""

# Rasmlar uchun bulutli ombor (Cloudflare R2). Bo'sh bo'lsa rasmlar lokal ./uploads papkasiga yoziladi (hosting uchun bo'sh bo'lmasin).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
